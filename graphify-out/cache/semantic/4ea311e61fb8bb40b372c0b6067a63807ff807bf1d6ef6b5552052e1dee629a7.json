{"nodes": [{"id": "basics_solution", "label": "Solving the equations", "file_type": "document", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "basics_solution_newtons_method", "label": "Newton's method", "file_type": "concept", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JutulDarcy solves systems that generally have both non-smooth behavior and physical constraints on the values. For that reason, Newton's method is modified to limit updates (Appleyard chopping, pressure/saturation/composition limits) so variables stay within physical boundaries."}, {"id": "basics_solution_appleyard_chopping", "label": "Appleyard Chopping", "file_type": "rationale", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "basics_solution_reservoir_linsolve", "label": "reservoir_linsolve", "file_type": "concept", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "basics_solution_block_backend", "label": "Block Backend", "file_type": "concept", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Determines the matrix format (block-CSC using StaticArrays.jl) and consequently the linear solver type to be used, enabling much more efficient sparse matrix-vector products and standard preconditioners."}, {"id": "basics_solution_cpr_preconditioner", "label": "CPRPreconditioner", "file_type": "concept", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-stage physics-informed preconditioner that seeks to decouple the global pressure part of the system from the local transport part, applying AMG to the pressure equation and ILU(0) to the full system."}, {"id": "basics_solution_generic_krylov", "label": "Jutul.GenericKrylov", "file_type": "concept", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "basics_solution_schur_complement", "label": "Schur Complement", "file_type": "concept", "source_file": "docs/src/man/basics/solution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly forming the Schur complement matrix J_rr - J_rw J_ww^-1 J_wr will lead to a lot of fill-in. JutulDarcy instead uses its action as a linear operator from LinearOperators.jl, applying the inverse of the well system when computing the residual/action. This is inexpensive because J_ww is small and the factorization can be stored."}], "edges": [{"source": "basics_solution", "target": "basics_solution_newtons_method", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution", "target": "basics_solution_appleyard_chopping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution", "target": "basics_solution_reservoir_linsolve", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution", "target": "basics_solution_block_backend", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution", "target": "basics_solution_cpr_preconditioner", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution", "target": "basics_solution_generic_krylov", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution", "target": "basics_solution_schur_complement", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution_newtons_method", "target": "basics_solution_appleyard_chopping", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution_reservoir_linsolve", "target": "basics_solution_block_backend", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution_reservoir_linsolve", "target": "basics_solution_generic_krylov", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution_reservoir_linsolve", "target": "basics_solution_cpr_preconditioner", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}, {"source": "basics_solution_schur_complement", "target": "basics_solution_cpr_preconditioner", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/src/man/basics/solution.md", "source_location": null, "weight": 1.0}], "hyperedges": []}